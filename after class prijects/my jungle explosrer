<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Jungle Explorer</title>

  <!-- Bootstrap CSS -->
  <link rel="stylesheet"
        href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">

  <style>
    body {
      position: relative;
    }

    .jungle-slide {
      height: 400px;
      color: white;
      text-align: center;
      padding-top: 150px;
    }

    .rainforest-slide {
      background-color: #228B22;
    }

    .river-slide {
      background-color: #1E90FF;
    }

    .night-slide {
      background-color: #191970;
    }

    .section {
      height: 500px;
      padding: 100px 30px;
      color: white;
      text-align: center;
    }

    #rainforest {
      background-color: #2E8B57;
    }

    #river {
      background-color: #20B2AA;
    }

    #night {
      background-color: #2F4F4F;
    }
  </style>
</head>

<body data-spy="scroll" data-target="#jungleNav" data-offset="60">

  <!-- Navigation Bar -->
  <nav id="jungleNav"
       class="navbar navbar-expand-sm bg-dark navbar-dark sticky-top">

    <a class="navbar-brand" href="#">Jungle Explorer</a>

    <ul class="navbar-nav">
      <li class="nav-item">
        <a class="nav-link" href="#rainforest">Rainforest</a>
      </li>

      <li class="nav-item">
        <a class="nav-link" href="#river">River</a>
      </li>

      <li class="nav-item">
        <a class="nav-link" href="#night">Night Jungle</a>
      </li>
    </ul>
  </nav>


  <!-- Bootstrap Carousel -->
  <div id="JungleCarousel"
       class="carousel slide"
       data-ride="carousel">

    <!-- Carousel Indicators -->
    <ul class="carousel-indicators">
      <li data-target="#JungleCarousel"
          data-slide-to="0"
          class="active"></li>

      <li data-target="#JungleCarousel"
          data-slide-to="1"></li>

      <li data-target="#JungleCarousel"
          data-slide-to="2"></li>
    </ul>


    <!-- Carousel Slides -->
    <div class="carousel-inner">

      <div class="carousel-item active">
        <div class="jungle-slide rainforest-slide">
          <h1>Rainforest Adventure</h1>
          <p>Explore the beautiful green rainforest.</p>
        </div>
      </div>

      <div class="carousel-item">
        <div class="jungle-slide river-slide">
          <h1>Jungle River Journey</h1>
          <p>Travel along a mysterious jungle river.</p>
        </div>
      </div>

      <div class="carousel-item">
        <div class="jungle-slide night-slide">
          <h1>Night Jungle Safari</h1>
          <p>Discover the jungle after the sun goes down.</p>
        </div>
      </div>

    </div>


    <!-- Previous Control -->
    <a class="carousel-control-prev"
       href="#JungleCarousel"
       data-slide="prev">

      <span class="carousel-control-prev-icon"></span>
    </a>


    <!-- Next Control -->
    <a class="carousel-control-next"
       href="#JungleCarousel"
       data-slide="next">

      <span class="carousel-control-next-icon"></span>
    </a>

  </div>


  <!-- Scrollspy Sections -->
  <div id="rainforest" class="section">
    <h1>Rainforest</h1>
    <p>
      The rainforest is filled with tall trees,
      colourful plants, birds, monkeys and many other animals.
    </p>
  </div>


  <div id="river" class="section">
    <h1>Jungle River</h1>
    <p>
      Jungle rivers provide water for plants and animals.
      They are home to fish, frogs and many fascinating creatures.
    </p>
  </div>


  <div id="night" class="section">
    <h1>Night Jungle</h1>
    <p>
      At night, the jungle becomes full of different sounds.
      Owls, insects and other nocturnal animals become active.
    </p>
  </div>


  <!-- jQuery -->
  <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>

  <!-- Bootstrap JavaScript -->
  <script src="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>

</body>
</html>